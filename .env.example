# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ecom-genai-dev
MONGODB_DB_NAME=ecom-genai-dev

# Atlas Admin API (for index creation scripts)
ATLAS_PUBLIC_KEY=your-atlas-public-key
ATLAS_PRIVATE_KEY=your-atlas-private-key
ATLAS_PROJECT_ID=your-atlas-project-id
ATLAS_CLUSTER_NAME=ecom-genai-dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# SQS Queue URLs (populated by Terraform outputs)
SQS_ORDER_PROCESSOR_URL=http://localhost:4566/000000000000/ecom-order-processor-dev
SQS_EMBEDDING_GENERATOR_URL=http://localhost:4566/000000000000/ecom-embedding-generator-dev
SQS_NOTIFICATION_URL=http://localhost:4566/000000000000/ecom-notification-dev
SQS_REVIEW_SUMMARIZER_URL=http://localhost:4566/000000000000/ecom-review-summarizer-dev

# EventBridge
EVENTBRIDGE_BUS_NAME=ecom-genai-dev

# S3
S3_PRODUCT_ASSETS_BUCKET=ecom-product-assets-dev
S3_ARTIFACTS_BUCKET=ecom-lambda-artifacts-dev

# Use LocalStack for local dev
AWS_ENDPOINT_URL=http://localhost:4566

# ─── Auth (AWS Cognito) ───────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=us-east-1_local
COGNITO_CLIENT_ID=local-client-id
JWT_SECRET=local-dev-secret-change-in-prod

# ─── AI / GenAI ───────────────────────────────────────────────────────────────
# 'openai' | 'bedrock'
AI_PROVIDER=openai

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4o

# AWS Bedrock (alternative to OpenAI)
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Seed data: 'mock' (random vectors) | 'real' (calls OpenAI)
SEED_EMBEDDINGS=mock

# ─── Kafka (MSK) ──────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ecom-genai-api
KAFKA_GROUP_ID=ecom-genai-workers
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL=false

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=ecom-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
