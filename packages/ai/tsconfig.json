{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "composite": true,
    "types": ["node"],
    "paths": {
      "@ecom/shared": ["../shared/src/index.ts"],
      "@ecom/db": ["../db/src/index.ts"]
    }
  },
  "references": [
    { "path": "../shared" },
    { "path": "../db" }
  ],
  "include": ["src/**/*"]
}
