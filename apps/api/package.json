{
  "name": "@ecom/api",
  "version": "0.1.0",
  "private": true,
  "description": "GraphQL API — Apollo Server 4 + Fastify 4",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc --project tsconfig.json && node scripts/copy-graphql.mjs",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@apollo/subgraph": "^2.9.3",
    "@as-integrations/fastify": "^2.1.1",
    "@aws-sdk/client-eventbridge": "^3.697.0",
    "@aws-sdk/client-sqs": "^3.697.0",
    "@ecom/ai": "workspace:*",
    "@ecom/db": "workspace:*",
    "@ecom/observability": "workspace:*",
    "@ecom/shared": "workspace:*",
    "@fastify/aws-lambda": "^6.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@graphql-tools/merge": "^9.0.0",
    "@graphql-tools/schema": "^10.0.0",
    "@graphql-tools/utils": "^10.0.0",
    "@opentelemetry/api": "^1.9.0",
    "dataloader": "^2.2.3",
    "fastify": "^4.29.0",
    "fastify-plugin": "^4.5.1",
    "graphql": "^16.9.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-query-complexity": "^0.12.0",
    "graphql-tag": "^2.12.6",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/typescript": "^4.1.1",
    "@graphql-codegen/typescript-resolvers": "^4.3.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "testcontainers": "^10.13.2",
    "tsx": "^4.19.0",
    "vitest": "^2.1.9"
  }
}
