{
  "name": "@ecom/worker",
  "version": "0.1.0",
  "private": true,
  "description": "SQS/Kafka event processor — Lambda handlers",
  "type": "module",
  "main": "./dist/lambda.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsx watch src/lambda.ts",
    "start": "node dist/lambda.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-eventbridge": "^3.697.0",
    "@opentelemetry/api": "^1.9.0",
    "@aws-sdk/client-sqs": "^3.697.0",
    "@aws-sdk/client-sns": "^3.697.0",
    "@aws-sdk/client-s3": "^3.697.0",
    "@ecom/ai": "workspace:*",
    "@ecom/db": "workspace:*",
    "@ecom/observability": "workspace:*",
    "@ecom/shared": "workspace:*",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.9"
  }
}
