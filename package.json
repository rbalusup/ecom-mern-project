{
  "name": "ecom-genai-lens",
  "version": "0.1.0",
  "private": true,
  "description": "E-Commerce GenAI Lens Backend Platform — Turborepo monorepo",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules",
    "seed": "tsx scripts/seed/seed.ts",
    "seed:embeddings": "SEED_EMBEDDINGS=real tsx scripts/seed/seed.ts",
    "backfill": "tsx scripts/backfill/backfill-embeddings.ts",
    "migrate": "tsx scripts/migrations/run-migrations.ts",
    "atlas:index": "tsx scripts/atlas/create-search-index.ts",
    "atlas:vector": "tsx scripts/atlas/create-vector-index.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.6.3"
    }
  }
}
